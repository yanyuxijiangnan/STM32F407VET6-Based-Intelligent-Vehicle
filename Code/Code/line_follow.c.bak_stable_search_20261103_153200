#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* 图像中线目标像素（128 点 CCD 中心） */
#define LINE_CENTER_PIXEL   64.0f
/* 巡线基础速度 0~100：保留用户当前调参 */
#define LINE_BASE_SPEED     40.0f
/* 丢线预判搜索时的前进速度（低于 BASE，避免冲出） */
#define LINE_SEARCH_SPEED   30.0f
/* 丢线搜索差速限幅 / 最小搜索差速 */
#define LINE_SEARCH_WZ      50.0f
#define LINE_SEARCH_WZ_MIN  25.0f
/* 左右差速限幅：保留用户当前调参 */
#define LINE_WZ_LIMIT       50.0f
/* 连续丢线超过该帧数仍未找回则停车（主循环约 20ms/帧） */
#define LINE_SEARCH_MAX_FRAMES  100U

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;

/* 丢线前最后一次有效纠偏，用于预判搜索方向 */
static float s_last_wz = 0.0f;
static float s_last_error = 0.0f;
static uint16_t s_lost_frames = 0U;

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

void LineFollow_Init(void)
{
  /* 转向环：target=中线像素，反馈=CCD_Center，输出作左右差速 */
  /* 保留用户当前调参：kp=0.9, ki=0, kd=0.04（勿改回 0.45/0.02） */
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  s_last_wz = 0.0f;
  s_last_error = 0.0f;
  s_lost_frames = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL;
  float vR;
  float wz;

  if (line_enabled == 0U)
  {
    return;
  }

  if (CCD_LineValid != 0U)
  {
    wz = PID_location(&line_steer_pid, (float)CCD_Center);
    wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
    line_error = line_steer_pid.error;
    line_wz = wz;

    /* 记住有效纠偏，供丢线预判搜索 */
    s_last_wz = wz;
    s_last_error = line_error;
    s_lost_frames = 0U;

    /* error=64-center>0 → 线偏左 → 左慢右快（wz>0 → vL小 vR大）视安装方向；
       若实车拐反，把下面 vL/vR 对调即可 */
    vL = LINE_BASE_SPEED - wz;
    vR = LINE_BASE_SPEED + wz;
  }
  else
  {
    /* 丢线：按丢线前误差/差速方向继续转弯搜索，超时再停车 */
    line_steer_pid.integral = 0.0f;
    if (s_lost_frames < 0xFFFFU)
    {
      s_lost_frames++;
    }

    if (s_lost_frames > LINE_SEARCH_MAX_FRAMES)
    {
      line_error = 0.0f;
      line_wz = 0.0f;
      vL = 0.0f;
      vR = 0.0f;
    }
    else
    {
      wz = s_last_wz;
      if ((wz > -LINE_SEARCH_WZ_MIN) && (wz < LINE_SEARCH_WZ_MIN))
      {
        if (s_last_error >= 0.0f)
        {
          wz = LINE_SEARCH_WZ_MIN;
        }
        else
        {
          wz = -LINE_SEARCH_WZ_MIN;
        }
      }
      wz = clampf(wz, -LINE_SEARCH_WZ, LINE_SEARCH_WZ);
      line_error = s_last_error;
      line_wz = wz;
      vL = LINE_SEARCH_SPEED - wz;
      vR = LINE_SEARCH_SPEED + wz;
    }
  }

  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}
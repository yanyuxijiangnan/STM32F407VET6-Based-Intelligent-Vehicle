#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* 图像中线目标像素（128 点 CCD 中心） */
#define LINE_CENTER_PIXEL   64.0f
/* 巡线基础速度 0~100，先慢后快 */
#define LINE_BASE_SPEED     40.0f //巡线基础速度 0～100
/* 丢线时使用的保守速度 */
#define LINE_LOST_SPEED     0.0f //丢线速度，现在停车；若要慢搜线可改成小正数
#define LINE_WZ_LIMIT       50.0f //左右差速限幅，转弯冲就减小，跟不上弯就加大

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;  
  return v;
}

void LineFollow_Init(void)
{
  /* 转向环：target=中线像素，反馈=CCD_Center，输出作左右差速 */
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);//kp=0.45：纠偏力度，抖就降、弯跟不上就加;ki：一般先保持 0;kd=0.02：抑制抖动;
	//
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL;
  float vR;
  float wz;

  if (line_enabled == 0U)
  {
    return;
  }

  if (CCD_LineValid != 0U)
  {
    wz = PID_location(&line_steer_pid, (float)CCD_Center);
    wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
    line_error = line_steer_pid.error;
    line_wz = wz;

    /* error=64-center>0 → 线偏左 → 左慢右快（wz>0 → vL小 vR大）视安装方向；
       若实车拐反，把下面 vL/vR 对调即可 */
    vL = LINE_BASE_SPEED - wz;
    vR = LINE_BASE_SPEED + wz;
  }
  else
  {
    /* 丢线：停车，避免冲出 */
    line_steer_pid.integral = 0.0f;
    line_error = 0.0f;
    line_wz = 0.0f;
    vL = LINE_LOST_SPEED;
    vR = LINE_LOST_SPEED;
  }

  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}
#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* ======================== line-follow params (road-tune macros) ======================== */
#define LINE_CENTER_PIXEL        64.0f
#define LINE_BASE_SPEED          38.0f
#define LINE_WZ_LIMIT            50.0f

/*
 * Unified steer polarity: maps geometric error sign -> wheel speeds.
 * Geometric: error = 64 - center; error>0 (line left) => turn_sign=+1.
 * Real car turns opposite: use -1. If road test is fully reversed again, change to +1.
 */
#define LINE_STEER_SIGN          (-1)

/* |error|>= : one-side-zero pivot while line still visible */
#define LINE_PIVOT_ERR           25.0f
#define LINE_PIVOT_SPEED         40.0f
/* |error|>= but below PIVOT: soft base + PID diff */
#define LINE_SOFT_ERR            14.0f
#define LINE_SOFT_BASE_SCALE     0.6f

/* On-line: update s_turn_sign only after |e|>=thr for N consecutive frames */
#define LINE_PREDICT_ERR         6.0f
#define LINE_PREDICT_HOLD_FRAMES 2U

/* Extreme center: immediate geometric turn_sign (line far left/right) */
#define LINE_EDGE_LEFT_MAX       24U
#define LINE_EDGE_RIGHT_MIN      104U

/* Center trend: consecutive frames |dCenter|>=thr same side => update turn_sign */
#define LINE_TREND_DELTA_MIN     3.0f
#define LINE_TREND_HOLD_FRAMES   2U

/* ---- lost-line recover ---- */
/* main loop ~20ms/frame (CCD + HAL_Delay(20)) */
#define LINE_SEARCH_SPEED        30.0f
#define LINE_SEARCH_WZ           50.0f
#define LINE_SEARCH_MAX_FRAMES   70U   /* ~1.4s locked-dir sweep then stop */

#define LINE_BACKUP_SPEED        28U
#define LINE_BACKUP_FRAMES       12U   /* short; only when no direction at all */
#define LINE_SWEEP_FRAMES        25U   /* ~0.50s per side */
#define LINE_COMMIT_FRAMES       4U    /* optional very short; prefer instant FOLLOW */
#define LINE_RECOVER_MAX_FRAMES  150U  /* ~3.0s total recover timeout */
#define LINE_FOLLOW_STABLE_FRAMES 8U   /* clear s_backup_used after stable follow */

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;
volatile uint8_t line_state = LF_FOLLOW;
volatile int8_t line_turn_sign = 0;  /* VOFA: geometric s_turn_sign (pre STEER_SIGN) */

static float s_last_error = 0.0f;
static int8_t s_turn_sign = 0;       /* geometric: error>0 / center left => +1 (VOFA) */
static int8_t s_hist_sign = 0;       /* last valid geometric turn direction */
static int8_t s_search_sign = 0;     /* locked geometric for SEARCH_LOCK / sweeps */
static int8_t s_predict_sign = 0;    /* COMMIT pivot direction (geometric) */
static uint16_t s_predict_hold = 0U; /* consecutive |e|>=PREDICT frames */

static float s_prev_center = LINE_CENTER_PIXEL;
static int8_t s_trend_dir = 0;       /* geometric move sign from center delta */
static uint8_t s_trend_hold = 0U;

static uint16_t s_phase_frames = 0U;
static uint16_t s_recover_frames = 0U;
static uint16_t s_follow_stable = 0U;
static uint8_t  s_sweep_round = 0U;
static uint8_t  s_pref_right = 0U;
static uint8_t  s_backup_used = 0U;  /* at most one BACKUP per recover episode */

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float absf(float v)
{
  return (v < 0.0f) ? -v : v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

static void sync_turn_sign_vofa(void)
{
  line_turn_sign = s_turn_sign;
}

static void remember_sign(int8_t s)
{
  if (s != 0)
  {
    s_hist_sign = s;
  }
}

static void set_turn_sign_geo(int8_t s)
{
  if (s == 0)
  {
    return;
  }
  s_turn_sign = s;
  remember_sign(s);
  sync_turn_sign_vofa();
}

/* sign = geometric; multiply LINE_STEER_SIGN at wheel mapping (avoid double flip) */
static void apply_pivot(int8_t sign, float *vL, float *vR)
{
  int8_t out = (int8_t)(sign * LINE_STEER_SIGN);

  if (out > 0)
  {
    *vL = 0.0f;
    *vR = LINE_PIVOT_SPEED;
    line_wz = LINE_PIVOT_SPEED;
  }
  else if (out < 0)
  {
    *vL = LINE_PIVOT_SPEED;
    *vR = 0.0f;
    line_wz = -LINE_PIVOT_SPEED;
  }
  else
  {
    *vL = LINE_BASE_SPEED;
    *vR = LINE_BASE_SPEED;
    line_wz = 0.0f;
  }
}

/* Locked-dir search: SEARCH_SPEED +/- SEARCH_WZ; sign geometric, * STEER_SIGN on output */
static void apply_search_lock(int8_t sign, float *vL, float *vR)
{
  float wz;
  int8_t out;

  if (sign == 0)
  {
    *vL = LINE_SEARCH_SPEED;
    *vR = LINE_SEARCH_SPEED;
    line_wz = 0.0f;
    return;
  }

  out = (int8_t)(sign * LINE_STEER_SIGN);
  wz = (float)out * LINE_SEARCH_WZ;
  line_wz = wz;
  *vL = LINE_SEARCH_SPEED - wz;
  *vR = LINE_SEARCH_SPEED + wz;
}

static void enter_state(uint8_t st)
{
  line_state = st;
  s_phase_frames = 0U;
}

static int8_t resolve_lock_sign(void)
{
  int8_t lock;

  lock = s_turn_sign;
  if (lock == 0)
  {
    lock = s_hist_sign;
  }
  if (lock == 0)
  {
    lock = signf_nonzero(s_last_error);
  }
  return lock;
}

static void plan_sweep_order(void)
{
  int8_t lock;

  lock = resolve_lock_sign();
  if (lock == 0)
  {
    lock = s_search_sign;
  }

  if (lock > 0)
  {
    s_pref_right = 1U;
    s_search_sign = lock;
    enter_state(LF_SWEEP_R);
  }
  else
  {
    s_pref_right = 0U;
    if (lock < 0)
    {
      s_search_sign = lock;
    }
    enter_state(LF_SWEEP_L);
  }
}

static void enter_search_lock(int8_t sign)
{
  line_steer_pid.integral = 0.0f;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  s_search_sign = sign;
  remember_sign(sign);
  enter_state(LF_SEARCH_LOCK);
}

static void enter_backup_once(void)
{
  line_steer_pid.integral = 0.0f;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  s_pref_right = 0U;
  s_backup_used = 1U;
  enter_state(LF_BACKUP);
}

/* Lost line from FOLLOW: prefer locked SEARCH; backup only if no direction and unused */
static void on_line_lost_from_follow(void)
{
  int8_t lock;

  lock = resolve_lock_sign();
  if (lock != 0)
  {
    enter_search_lock(lock);
    return;
  }

  if (s_backup_used == 0U)
  {
    enter_backup_once();
    return;
  }

  /* already backed up once this episode: blind L/R sweep */
  line_steer_pid.integral = 0.0f;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  plan_sweep_order();
}

static void output_lr(float vL, float vR)
{
  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}

static void update_turn_sign_stable(float abs_err, int8_t err_sign)
{
  if ((abs_err >= LINE_PREDICT_ERR) && (err_sign != 0))
  {
    if (s_predict_hold < 0xFFFFU)
    {
      s_predict_hold++;
    }
    if (s_predict_hold >= LINE_PREDICT_HOLD_FRAMES)
    {
      set_turn_sign_geo(err_sign);
    }
  }
  else
  {
    s_predict_hold = 0U;
  }
}

/* Extreme CCD_Center: line already on far left/right => geometric turn_sign */
static void update_turn_sign_edge(void)
{
  if (CCD_Center <= LINE_EDGE_LEFT_MAX)
  {
    set_turn_sign_geo(+1);  /* line left */
  }
  else if (CCD_Center >= LINE_EDGE_RIGHT_MIN)
  {
    set_turn_sign_geo(-1);  /* line right */
  }
}

/* Center trend: same-side move 2+ frames with |d|>=3 => update geometric turn_sign */
static void update_turn_sign_trend(void)
{
  float delta;
  int8_t move_sign;

  delta = (float)CCD_Center - s_prev_center;
  move_sign = 0;
  if (delta <= -LINE_TREND_DELTA_MIN)
  {
    move_sign = +1;  /* center smaller => line left */
  }
  else if (delta >= LINE_TREND_DELTA_MIN)
  {
    move_sign = -1;  /* center larger => line right */
  }

  if (move_sign != 0)
  {
    if (move_sign == s_trend_dir)
    {
      if (s_trend_hold < 0xFFU)
      {
        s_trend_hold++;
      }
      if (s_trend_hold >= LINE_TREND_HOLD_FRAMES)
      {
        set_turn_sign_geo(move_sign);
      }
    }
    else
    {
      s_trend_dir = move_sign;
      s_trend_hold = 1U;
    }
  }
  else
  {
    s_trend_dir = 0;
    s_trend_hold = 0U;
  }

  s_prev_center = (float)CCD_Center;
}

static void follow_with_line(float *vL, float *vR)
{
  float wz;
  float abs_err;
  float base;
  int8_t err_sign;

  wz = PID_location(&line_steer_pid, (float)CCD_Center);
  wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
  line_error = line_steer_pid.error;
  abs_err = absf(line_error);
  err_sign = signf_nonzero(line_error);

  s_last_error = line_error;

  /* earlier predict: hold=2 @ |e|>=6, plus edge + center trend (all geometric) */
  update_turn_sign_stable(abs_err, err_sign);
  update_turn_sign_edge();
  update_turn_sign_trend();

  if (abs_err >= LINE_PIVOT_ERR)
  {
    /* line still visible, large error: direct pivot, never backup */
    apply_pivot(err_sign, vL, vR);
    if (err_sign != 0)
    {
      /* hard commit geometric direction on big visible bend */
      set_turn_sign_geo(err_sign);
      s_predict_hold = LINE_PREDICT_HOLD_FRAMES;
    }
  }
  else
  {
    base = LINE_BASE_SPEED;
    if (abs_err >= LINE_SOFT_ERR)
    {
      base = LINE_BASE_SPEED * LINE_SOFT_BASE_SCALE;
    }
    /* PID wz is geometric; flip polarity once before wheel map */
    wz *= (float)LINE_STEER_SIGN;
    line_wz = wz;
    *vL = base - wz;
    *vR = base + wz;
  }

  sync_turn_sign_vofa();
}

static int8_t make_predict_sign(int8_t sweep_side_sign)
{
  int8_t s = signf_nonzero(LINE_CENTER_PIXEL - (float)CCD_Center);
  if (s == 0)
  {
    s = sweep_side_sign;
  }
  if (s == 0)
  {
    s = s_search_sign;
  }
  if (s == 0)
  {
    s = s_turn_sign;
  }
  if (s == 0)
  {
    s = signf_nonzero(s_last_error);
  }
  if (s == 0)
  {
    s = s_hist_sign;
  }
  if (s == 0)
  {
    s = 1;
  }
  remember_sign(s);
  return s;
}

static void on_sweep_side_done(uint8_t just_finished_left)
{
  if (just_finished_left != 0U)
  {
    if (s_pref_right == 0U)
    {
      enter_state(LF_SWEEP_R);
    }
    else
    {
      s_sweep_round++;
      if (s_sweep_round >= 1U)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_R);
      }
    }
  }
  else
  {
    if (s_pref_right != 0U)
    {
      enter_state(LF_SWEEP_L);
    }
    else
    {
      s_sweep_round++;
      if (s_sweep_round >= 1U)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_L);
      }
    }
  }
}

/* Found line during recover: go FOLLOW immediately (skip long COMMIT tug) */
static void resume_follow_from_search(float *vL, float *vR)
{
  s_recover_frames = 0U;
  s_follow_stable = 0U;
  enter_state(LF_FOLLOW);
  follow_with_line(vL, vR);
  output_lr(*vL, *vR);
}

void LineFollow_Init(void)
{
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  line_error = 0.0f;
  line_wz = 0.0f;
  line_vL = 0;
  line_vR = 0;
  line_state = LF_FOLLOW;
  line_turn_sign = 0;
  s_last_error = 0.0f;
  s_turn_sign = 0;
  s_hist_sign = 0;
  s_search_sign = 0;
  s_predict_sign = 0;
  s_predict_hold = 0U;
  s_prev_center = LINE_CENTER_PIXEL;
  s_trend_dir = 0;
  s_trend_hold = 0U;
  s_phase_frames = 0U;
  s_recover_frames = 0U;
  s_follow_stable = 0U;
  s_sweep_round = 0U;
  s_pref_right = 0U;
  s_backup_used = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL = 0.0f;
  float vR = 0.0f;

  if (line_enabled == 0U)
  {
    return;
  }

  /* ---------- LF_FOLLOW: on-line PID / soft / pivot ---------- */
  if (line_state == LF_FOLLOW)
  {
    if (CCD_LineValid != 0U)
    {
      s_recover_frames = 0U;
      if (s_follow_stable < 0xFFFFU)
      {
        s_follow_stable++;
      }
      /* after stable follow, allow one backup again next episode */
      if (s_follow_stable >= LINE_FOLLOW_STABLE_FRAMES)
      {
        s_backup_used = 0U;
      }
      follow_with_line(&vL, &vR);
      output_lr(vL, vR);
      return;
    }

    s_follow_stable = 0U;
    on_line_lost_from_follow();
  }

  /* recover timeout */
  if ((line_state != LF_FOLLOW) && (line_state != LF_STOP))
  {
    if (s_recover_frames < 0xFFFFU)
    {
      s_recover_frames++;
    }
    if (s_recover_frames > LINE_RECOVER_MAX_FRAMES)
    {
      enter_state(LF_STOP);
    }
  }

  if (s_phase_frames < 0xFFFFU)
  {
    s_phase_frames++;
  }

  switch (line_state)
  {
    case LF_BACKUP:
      /*
       * Ignore LineValid flicker while backing: do not bounce BACKUP<->FOLLOW.
       * Finish short backup, then sweep; s_backup_used blocks another BACKUP.
       */
      Motor_backward(LINE_BACKUP_SPEED);
      line_error = s_last_error;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;

      if (s_phase_frames >= LINE_BACKUP_FRAMES)
      {
        /* after backup: if direction appeared, lock-search; else L/R sweep */
        {
          int8_t lock = resolve_lock_sign();
          if (lock != 0)
          {
            enter_search_lock(lock);
          }
          else
          {
            plan_sweep_order();
          }
        }
      }
      break;

    case LF_SEARCH_LOCK:
      /* locked geometric sign; STEER_SIGN applied inside apply_search_lock */
      if (CCD_LineValid != 0U)
      {
        resume_follow_from_search(&vL, &vR);
        break;
      }

      apply_search_lock(s_search_sign, &vL, &vR);
      line_error = s_last_error;
      sync_turn_sign_vofa();
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SEARCH_MAX_FRAMES)
      {
        enter_state(LF_STOP);
      }
      break;

    case LF_SWEEP_L:
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(-1);
        resume_follow_from_search(&vL, &vR);
        break;
      }

      apply_pivot(-1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(1U);
      }
      break;

    case LF_SWEEP_R:
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(+1);
        resume_follow_from_search(&vL, &vR);
        break;
      }

      apply_pivot(+1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(0U);
      }
      break;

    case LF_COMMIT:
      /* kept for VOFA compatibility; normally unused (instant FOLLOW) */
      apply_pivot(s_predict_sign, &vL, &vR);
      if (CCD_LineValid != 0U)
      {
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
      }
      else
      {
        line_error = s_last_error;
      }
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_COMMIT_FRAMES)
      {
        enter_state(LF_FOLLOW);
      }
      break;

    case LF_STOP:
      line_error = 0.0f;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;
      Motor_Coast();
      if (CCD_LineValid != 0U)
      {
        s_backup_used = 0U;
        s_follow_stable = 0U;
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
      }
      break;

    default:
      enter_state(LF_FOLLOW);
      break;
  }
}

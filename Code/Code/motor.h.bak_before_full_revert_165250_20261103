#ifndef __MOTOR_H__
#define __MOTOR_H__

#include "bsp_system.h"
#include "tim.h"

#define MAX_SPEED 100
#define MIN_SPEED 0

/* 运行模式：FWD=正转闭环/开环跟 cmd；BACK=开环后退；PIVOT=左右独立正反；HOLD=预留 */
#define MOTOR_MODE_FWD   0U
#define MOTOR_MODE_BACK  1U
#define MOTOR_MODE_PIVOT 2U   /* 左右轮可独立正反转，用于差速 pivot */
#define MOTOR_MODE_HOLD  3U

typedef enum {
  SLOW_DECAY,
  FAST_DECAY
} Decay_Mode;

void Motor_Init(void);
void Motor_SetDuty(char motor, uint16_t IN1, uint16_t IN2);
void Motor_SetWheelSpeed(char motor, uint16_t speed);
void Motor_ApplyBackwardDuty(uint16_t speed);
void Motor_SetLR(uint16_t vL, uint16_t vR);
void Motor_SetLR_signed(int16_t vL, int16_t vR);
void Motor_forward(uint16_t speed);
void Motor_backward(uint16_t speed);
void Motor_brake(void);
void Motor_Coast(void);
void Motor_SetDecayMode(Decay_Mode mode);

extern volatile int16_t  motor_cmd_L;
extern volatile int16_t  motor_cmd_R;
extern volatile uint16_t motor_cmd_back;
extern volatile uint8_t  motor_run_mode;

#endif

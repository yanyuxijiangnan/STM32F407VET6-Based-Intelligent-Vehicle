#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* ======================== 巡线参数（路测可改宏） ======================== */
/* 图像中线目标像素：CCD 中心约 64 */
#define LINE_CENTER_PIXEL        64.0f
/* 巡线基础速度 0~100 */
#define LINE_BASE_SPEED          40.0f
/* 左右差速限幅（普通 PID 模式） */
#define LINE_WZ_LIMIT            50.0f

/* |error|>=此值：进入单侧静止 pivot（近似原地转） */
#define LINE_PIVOT_ERR           25.0f
/* pivot 时运动侧轮速度，对侧 0 */
#define LINE_PIVOT_SPEED         40.0f
/* |error|>=此值但未达 PIVOT：降速差速 */
#define LINE_SOFT_ERR            14.0f
#define LINE_SOFT_BASE_SCALE     0.6f

/* |error| 达此阈值时更新转弯预判符号（有线维护） */
#define LINE_PREDICT_ERR         10.0f

/* ---- 丢线恢复：后退 -> 左右扫线 -> 预判 commit -> 巡线 ---- */
/* 后退速度 0~100；帧数约主循环 20ms/帧 */
#define LINE_BACKUP_SPEED        28U
#define LINE_BACKUP_FRAMES       20U   /* ~0.40s */
#define LINE_SWEEP_FRAMES        28U   /* ~0.56s 单侧 */
#define LINE_SWEEP_ROUNDS        2U    /* 左右各扫一轮计 1 轮 */
#define LINE_COMMIT_FRAMES       15U   /* ~0.30s 预判方向短转 */
#define LINE_RECOVER_MAX_FRAMES  180U  /* ~3.6s 总超时强制停 */

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;
volatile uint8_t line_state = LF_FOLLOW;

static float s_last_error = 0.0f;
static int8_t s_turn_sign = 0;       /* error>0 => +1：左慢右快 / 右轮驱动 pivot */
static int8_t s_hist_sign = 0;       /* 上次有效转弯方向 */
static int8_t s_predict_sign = 0;    /* 扫到线后的预判方向 */

static uint16_t s_phase_frames = 0U;   /* 当前子状态帧计数 */
static uint16_t s_recover_frames = 0U; /* 本段丢线恢复累计帧 */
static uint8_t  s_sweep_round = 0U;    /* 已完成的左右扫轮数 */

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float absf(float v)
{
  return (v < 0.0f) ? -v : v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

static void remember_sign(int8_t s)
{
  if (s != 0)
  {
    s_hist_sign = s;
  }
}

static void apply_pivot(int8_t sign, float *vL, float *vR)
{
  if (sign > 0)
  {
    *vL = 0.0f;
    *vR = LINE_PIVOT_SPEED;
    line_wz = LINE_PIVOT_SPEED;
  }
  else if (sign < 0)
  {
    *vL = LINE_PIVOT_SPEED;
    *vR = 0.0f;
    line_wz = -LINE_PIVOT_SPEED;
  }
  else
  {
    *vL = LINE_BASE_SPEED;
    *vR = LINE_BASE_SPEED;
    line_wz = 0.0f;
  }
}

static void enter_state(uint8_t st)
{
  line_state = st;
  s_phase_frames = 0U;
}

static void enter_backup_from_lost(void)
{
  line_steer_pid.integral = 0.0f;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  enter_state(LF_BACKUP);
}

static void output_lr(float vL, float vR)
{
  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}

static void follow_with_line(float *vL, float *vR)
{
  float wz;
  float abs_err;
  float base;
  int8_t err_sign;

  wz = PID_location(&line_steer_pid, (float)CCD_Center);
  wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
  line_error = line_steer_pid.error;
  abs_err = absf(line_error);
  err_sign = signf_nonzero(line_error);

  s_last_error = line_error;

  if (abs_err >= LINE_PREDICT_ERR)
  {
    if (err_sign != 0)
    {
      s_turn_sign = err_sign;
      remember_sign(err_sign);
    }
  }

  if (abs_err >= LINE_PIVOT_ERR)
  {
    /* 急弯：单侧轮不动，另一侧转 */
    apply_pivot(err_sign, vL, vR);
    if (err_sign != 0)
    {
      s_turn_sign = err_sign;
      remember_sign(err_sign);
    }
  }
  else
  {
    base = LINE_BASE_SPEED;
    if (abs_err >= LINE_SOFT_ERR)
    {
      base = LINE_BASE_SPEED * LINE_SOFT_BASE_SCALE;
    }
    line_wz = wz;
    *vL = base - wz;
    *vR = base + wz;
  }
}

/* 扫到线：用 CCD 中心偏差符号；若为 0 则用扫线侧 / 历史 */
static int8_t make_predict_sign(int8_t sweep_side_sign)
{
  int8_t s = signf_nonzero(LINE_CENTER_PIXEL - (float)CCD_Center);
  if (s == 0)
  {
    s = sweep_side_sign;
  }
  if (s == 0)
  {
    s = s_turn_sign;
  }
  if (s == 0)
  {
    s = signf_nonzero(s_last_error);
  }
  if (s == 0)
  {
    s = s_hist_sign;
  }
  if (s == 0)
  {
    s = 1; /* 极端兜底：向左转 */
  }
  remember_sign(s);
  return s;
}

void LineFollow_Init(void)
{
  /* 转向环：保留用户当前调参 kp=0.9, ki=0, kd=0.04 */
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  line_error = 0.0f;
  line_wz = 0.0f;
  line_vL = 0;
  line_vR = 0;
  line_state = LF_FOLLOW;
  s_last_error = 0.0f;
  s_turn_sign = 0;
  s_hist_sign = 0;
  s_predict_sign = 0;
  s_phase_frames = 0U;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL = 0.0f;
  float vR = 0.0f;

  if (line_enabled == 0U)
  {
    return;
  }

  /* ---------- LF_FOLLOW：有线 PID / pivot ---------- */
  if (line_state == LF_FOLLOW)
  {
    if (CCD_LineValid != 0U)
    {
      s_recover_frames = 0U;
      follow_with_line(&vL, &vR);
      output_lr(vL, vR);
      return;
    }

    /* 丢线：进入后退恢复，勿立刻乱 pivot */
    enter_backup_from_lost();
  }

  /* 恢复段累计超时 */
  if (line_state != LF_FOLLOW && line_state != LF_STOP)
  {
    if (s_recover_frames < 0xFFFFU)
    {
      s_recover_frames++;
    }
    if (s_recover_frames > LINE_RECOVER_MAX_FRAMES)
    {
      enter_state(LF_STOP);
    }
  }

  if (s_phase_frames < 0xFFFFU)
  {
    s_phase_frames++;
  }

  switch (line_state)
  {
    case LF_BACKUP:
      /* 后退中突然见线：直接回巡线 */
      if (CCD_LineValid != 0U)
      {
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
        break;
      }

      Motor_backward(LINE_BACKUP_SPEED);
      line_error = s_last_error;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;

      if (s_phase_frames >= LINE_BACKUP_FRAMES)
      {
        enter_state(LF_SWEEP_L);
      }
      break;

    case LF_SWEEP_L:
      /* 与 error<0 同侧：vL=PIVOT, vR=0 */
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(-1);
        enter_state(LF_COMMIT);
        apply_pivot(s_predict_sign, &vL, &vR);
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
        output_lr(vL, vR);
        break;
      }

      apply_pivot(-1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        enter_state(LF_SWEEP_R);
      }
      break;

    case LF_SWEEP_R:
      /* 与 error>0 同侧：vL=0, vR=PIVOT */
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(+1);
        enter_state(LF_COMMIT);
        apply_pivot(s_predict_sign, &vL, &vR);
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
        output_lr(vL, vR);
        break;
      }

      apply_pivot(+1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        s_sweep_round++;
        if (s_sweep_round >= LINE_SWEEP_ROUNDS)
        {
          enter_state(LF_STOP);
        }
        else
        {
          enter_state(LF_SWEEP_L);
        }
      }
      break;

    case LF_COMMIT:
      /* 短时向预判方向 pivot，然后回 FOLLOW */
      apply_pivot(s_predict_sign, &vL, &vR);
      if (CCD_LineValid != 0U)
      {
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
      }
      else
      {
        line_error = s_last_error;
      }
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_COMMIT_FRAMES)
      {
        enter_state(LF_FOLLOW);
      }
      break;

    case LF_STOP:
      line_error = 0.0f;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;
      Motor_Coast();
      /* 若又见线，允许重新开始巡线 */
      if (CCD_LineValid != 0U)
      {
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
      }
      break;

    default:
      enter_state(LF_FOLLOW);
      break;
  }
}

#ifndef __LINE_FOLLOW_H__
#define __LINE_FOLLOW_H__

#include <stdint.h>
#include "PID.h"

/* 巡线状态机（VOFA 可读 line_state） */
#define LF_FOLLOW   0U
#define LF_BACKUP   1U
#define LF_SEARCH   2U   /* 锁定方向 signed pivot 搜线 ~1.2~1.5s */
#define LF_SWEEP_L  3U   /* 无方向兜底：左侧扫 */
#define LF_SWEEP_R  4U   /* 无方向兜底：右侧扫 */
#define LF_COMMIT   5U   /* 兼容保留；见线优先直接 FOLLOW */
#define LF_STOP     6U

void LineFollow_Init(void);
void LineFollow_Update(void);

extern PID line_steer_pid;
extern volatile float line_error;
extern volatile float line_wz;
extern volatile uint16_t line_vL;   /* 绝对值，供 VOFA 显示 */
extern volatile uint16_t line_vR;   /* 绝对值，供 VOFA 显示 */
extern volatile int16_t  line_vL_signed;  /* 有符号值，含方向 */
extern volatile int16_t  line_vR_signed;  /* 有符号值，含方向 */
extern volatile uint8_t line_enabled;
extern volatile uint8_t line_state;
extern volatile int8_t  line_turn_sign;   /* VOFA：几何预判方向 */

#endif
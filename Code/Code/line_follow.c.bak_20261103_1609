#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* ======================== 巡线参数（路测可改宏）======================== */
/* 图像中线目标像素：CCD 中心约 64 */
#define LINE_CENTER_PIXEL        64.0f
/* 巡线基础速度 0~100：保留用户当前调参 */
#define LINE_BASE_SPEED          40.0f
/* 左右差速限幅（普通 PID 模式）：保留用户当前调参 */
#define LINE_WZ_LIMIT            50.0f

/* |error|>=此值：进入单侧静止 pivot（近似原地转），建议 22~28 */
#define LINE_PIVOT_ERR           25.0f
/* pivot 时运动侧轮速度，对侧 0；建议 35~45 */
#define LINE_PIVOT_SPEED         40.0f
/* |error|>=此值但未达 PIVOT：降速差速（base*SOFT_SCALE），建议 12~18 */
#define LINE_SOFT_ERR            14.0f
#define LINE_SOFT_BASE_SCALE     0.6f

/* 丢线搜索：始终进入搜索；持续无效线超过本帧数才停车（约 20ms/帧） */
/* 80~120 ≈ 1.6~2.4s，直角弯车身大 CCD 扫空时靠此延时 + pivot 搜回 */
#define LINE_SEARCH_MAX_FRAMES   100U
/* 无历史方向时的短时低速直行速度（兜底，优先仍用历史方向 pivot） */
#define LINE_SEARCH_CREEP_SPEED  18.0f

/* |error| 达此阈值时更新转弯预判符号（有线维护，供丢线方向锁） */
#define LINE_PREDICT_ERR         10.0f

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;

/* 有线时维护；丢线时用历史方向做 pivot 搜索，超时才停 */
static float s_last_error = 0.0f;
static uint16_t s_lost_frames = 0U;
static int8_t s_turn_sign = 0;      /* error>0 => +1：左慢右快 / 右轮驱动 pivot */
static int8_t s_search_sign = 0;    /* 丢线首帧锁定，搜索期间固定 */
static int8_t s_hist_sign = 0;      /* 上次有效转弯方向（跨有线/丢线保留） */

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float absf(float v)
{
  return (v < 0.0f) ? -v : v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

static void remember_sign(int8_t s)
{
  if (s != 0)
  {
    s_hist_sign = s;
  }
}

void LineFollow_Init(void)
{
  /* 转向环：target=中线像素，反馈 CCD_Center，输出作左右差速 */
  /* 保留用户当前调参：kp=0.9, ki=0, kd=0.04 */
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  line_error = 0.0f;
  line_wz = 0.0f;
  line_vL = 0;
  line_vR = 0;
  s_last_error = 0.0f;
  s_lost_frames = 0U;
  s_turn_sign = 0;
  s_search_sign = 0;
  s_hist_sign = 0;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL;
  float vR;
  float wz;
  float abs_err;
  float base;
  int8_t err_sign;

  if (line_enabled == 0U)
  {
    return;
  }

  if (CCD_LineValid != 0U)
  {
    /* ---------- A. 有线：LineValid ---------- */
    wz = PID_location(&line_steer_pid, (float)CCD_Center);
    wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
    line_error = line_steer_pid.error;
    abs_err = absf(line_error);
    err_sign = signf_nonzero(line_error);

    s_last_error = line_error;
    s_lost_frames = 0U;
    /* 找回线后清本段搜索锁；历史方向 s_hist_sign 保留供下次直角弯 */
    s_search_sign = 0;

    /* 维护转弯预判：大误差时记下符号，供丢线方向锁 */
    if (abs_err >= LINE_PREDICT_ERR)
    {
      if (err_sign != 0)
      {
        s_turn_sign = err_sign;
        remember_sign(err_sign);
      }
    }

    if (abs_err >= LINE_PIVOT_ERR)
    {
      /* 急弯/小环：单侧轮不动，另一侧转（差速到一侧≈0） */
      /* error>0 => 左慢右快 / 右轮驱动；若实车拐反：对调 vL/vR */
      if (err_sign > 0)
      {
        vL = 0.0f;
        vR = LINE_PIVOT_SPEED;
        line_wz = LINE_PIVOT_SPEED;
      }
      else if (err_sign < 0)
      {
        vL = LINE_PIVOT_SPEED;
        vR = 0.0f;
        line_wz = -LINE_PIVOT_SPEED;
      }
      else
      {
        vL = LINE_BASE_SPEED;
        vR = LINE_BASE_SPEED;
        line_wz = 0.0f;
      }
      if (err_sign != 0)
      {
        s_turn_sign = err_sign;
        remember_sign(err_sign);
      }
    }
    else
    {
      /* 中等/小误差：普通 BASE±wz；大误差时自动降速 */
      base = LINE_BASE_SPEED;
      if (abs_err >= LINE_SOFT_ERR)
      {
        base = LINE_BASE_SPEED * LINE_SOFT_BASE_SCALE;
      }
      line_wz = wz;
      vL = base - wz;
      vR = base + wz;
    }
  }
  else
  {
    /* ---------- B. 丢线：始终搜索；持续超时才停车 ---------- */
    line_steer_pid.integral = 0.0f;

    if (s_lost_frames == 0U)
    {
      /* 首帧锁定搜索方向：turn_sign > last_error 符号 > 历史 sign */
      if (s_turn_sign != 0)
      {
        s_search_sign = s_turn_sign;
      }
      else if (signf_nonzero(s_last_error) != 0)
      {
        s_search_sign = signf_nonzero(s_last_error);
      }
      else if (s_hist_sign != 0)
      {
        s_search_sign = s_hist_sign;
      }
      else if (s_search_sign != 0)
      {
        /* 保留上次未清的 search_sign（极端兜底） */
      }
      else
      {
        s_search_sign = 0;
      }
      remember_sign(s_search_sign);
    }

    if (s_lost_frames < 0xFFFFU)
    {
      s_lost_frames++;
    }

    if (s_lost_frames > LINE_SEARCH_MAX_FRAMES)
    {
      /* 扫不到线持续一段时间：停车 */
      line_error = 0.0f;
      line_wz = 0.0f;
      vL = 0.0f;
      vR = 0.0f;
    }
    else if (s_search_sign != 0)
    {
      /* 有历史/锁定方向：pivot 搜索（同有线急弯，利于直角弯扫回） */
      line_error = s_last_error;
      if (s_search_sign > 0)
      {
        vL = 0.0f;
        vR = LINE_PIVOT_SPEED;
        line_wz = LINE_PIVOT_SPEED;
      }
      else
      {
        vL = LINE_PIVOT_SPEED;
        vR = 0.0f;
        line_wz = -LINE_PIVOT_SPEED;
      }
    }
    else
    {
      /* 无任何方向信息：短时低速直行，仍等超时再停（不立刻刹停） */
      line_error = 0.0f;
      line_wz = 0.0f;
      vL = LINE_SEARCH_CREEP_SPEED;
      vR = LINE_SEARCH_CREEP_SPEED;
    }
  }

  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}
#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* ======================== 巡线参数（稳妥默认，路测可改宏） ======================== */
#define LINE_CENTER_PIXEL        64.0f
#define LINE_BASE_SPEED          38.0f
#define LINE_WZ_LIMIT            50.0f

/* |error|>=此值：差速反转 pivot（一轮正转一轮反转） */
#define LINE_PIVOT_ERR           25.0f
#define LINE_PIVOT_SPEED         40.0f
/* |error|>=此值但未达 PIVOT：降速差速 */
#define LINE_SOFT_ERR            14.0f
#define LINE_SOFT_BASE_SCALE     0.6f

/* 有线时维护 turn_sign 的低阈值（1 帧即可锁定） */
#define LINE_PREDICT_ERR         8.0f

/* ---- 丢线恢复：BACKUP -> 锁定方向优先单侧扫 -> 对侧扫 -> COMMIT -> FOLLOW ---- */
/* 主循环约 20ms/帧（CCD + HAL_Delay(20)） */
#define LINE_BACKUP_SPEED        28U
#define LINE_BACKUP_FRAMES       18U   /* ~0.36s */
#define LINE_SWEEP_FRAMES        25U   /* ~0.50s 单侧 */
#define LINE_SWEEP_ROUNDS        2U    /* 两侧各一轮计 1 轮；最多 2 轮或总超时 */
#define LINE_COMMIT_FRAMES       12U   /* ~0.24s */
#define LINE_RECOVER_MAX_FRAMES  150U  /* ~3.0s 总超时强制停 */

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile int16_t  line_vL_signed = 0;
volatile int16_t  line_vR_signed = 0;
volatile uint8_t line_enabled = 1;
volatile uint8_t line_state = LF_FOLLOW;

static float s_last_error = 0.0f;
static int8_t s_turn_sign = 0;       /* error>0 => +1：左慢右快 / 右轮驱动 pivot */
static int8_t s_hist_sign = 0;       /* 上次有效转弯方向 */
static int8_t s_predict_sign = 0;    /* 扫到线后的预判方向 */

static uint16_t s_phase_frames = 0U;
static uint16_t s_recover_frames = 0U;
static uint8_t  s_sweep_round = 0U;
/* 1=优先右扫(SWEEP_R 先)，0=优先左扫(SWEEP_L 先，含无锁定) */
static uint8_t  s_pref_right = 0U;

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float absf(float v)
{
  return (v < 0.0f) ? -v : v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

static void remember_sign(int8_t s)
{
  if (s != 0)
  {
    s_hist_sign = s;
  }
}

static void apply_pivot(int8_t sign, float *vL, float *vR)
{
  if (sign > 0)
  {
    /* 右转：左轮反转，右轮正转 → 原地差速右转 */
    *vL = -LINE_PIVOT_SPEED;
    *vR =  LINE_PIVOT_SPEED;
    line_wz = LINE_PIVOT_SPEED;
  }
  else if (sign < 0)
  {
    /* 左转：左轮正转，右轮反转 → 原地差速左转 */
    *vL =  LINE_PIVOT_SPEED;
    *vR = -LINE_PIVOT_SPEED;
    line_wz = -LINE_PIVOT_SPEED;
  }
  else
  {
    *vL = LINE_BASE_SPEED;
    *vR = LINE_BASE_SPEED;
    line_wz = 0.0f;
  }
}

static void enter_state(uint8_t st)
{
  line_state = st;
  s_phase_frames = 0U;
}

static void plan_sweep_order(void)
{
  int8_t lock;

  lock = s_turn_sign;
  if (lock == 0)
  {
    lock = s_hist_sign;
  }

  /* 已锁定方向优先；无方向则左扫 -> 右扫 */
  if (lock > 0)
  {
    s_pref_right = 1U;
    enter_state(LF_SWEEP_R);
  }
  else
  {
    s_pref_right = 0U;
    enter_state(LF_SWEEP_L);
  }
}

static void enter_backup_from_lost(void)
{
  line_steer_pid.integral = 0.0f;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  s_pref_right = 0U;

  /* 弯道中丢线（已有方向锁定）：跳过后退，直接扫线搜索 */
  if (s_turn_sign != 0)
  {
    plan_sweep_order();
  }
  else
  {
    /* 直道丢线（可能是断线/路口）：先后退再扫 */
    enter_state(LF_BACKUP);
  }
}

static void output_lr(float vL, float vR)
{
  /* clamp 到 [-MAX_SPEED, +MAX_SPEED]，负值表示反转 */
  vL = clampf(vL, -(float)MAX_SPEED, (float)MAX_SPEED);
  vR = clampf(vR, -(float)MAX_SPEED, (float)MAX_SPEED);

  /* 存储 signed 值（含方向）和 unsigned 值（绝对值，供 VOFA 显示） */
  line_vL_signed = (int16_t)vL;
  line_vR_signed = (int16_t)vR;
  line_vL = (uint16_t)(vL < 0.0f ? -vL : vL);
  line_vR = (uint16_t)(vR < 0.0f ? -vR : vR);

  /* 有负值 → 差速 pivot 模式；全正值 → 普通 FWD 模式 */
  if ((vL < 0.0f) || (vR < 0.0f))
  {
    Motor_SetLR_signed((int16_t)vL, (int16_t)vR);
  }
  else
  {
    Motor_SetLR((uint16_t)vL, (uint16_t)vR);
  }
}

static void follow_with_line(float *vL, float *vR)
{
  float wz;
  float abs_err;
  float base;
  int8_t err_sign;

  wz = PID_location(&line_steer_pid, (float)CCD_Center);
  wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
  line_error = line_steer_pid.error;
  abs_err = absf(line_error);
  err_sign = signf_nonzero(line_error);

  s_last_error = line_error;

  /* 低阈值、1 帧即可维护 turn_sign */
  if (abs_err >= LINE_PREDICT_ERR)
  {
    if (err_sign != 0)
    {
      s_turn_sign = err_sign;
      remember_sign(err_sign);
    }
  }

  if (abs_err >= LINE_PIVOT_ERR)
  {
    apply_pivot(err_sign, vL, vR);
    if (err_sign != 0)
    {
      s_turn_sign = err_sign;
      remember_sign(err_sign);
    }
  }
  else
  {
    base = LINE_BASE_SPEED;
    if (abs_err >= LINE_SOFT_ERR)
    {
      base = LINE_BASE_SPEED * LINE_SOFT_BASE_SCALE;
    }
    line_wz = wz;
    *vL = base - wz;
    *vR = base + wz;
  }
}

/* 扫到线：用 CCD 中心偏差符号；若为 0 则用扫线侧 / 历史 */
static int8_t make_predict_sign(int8_t sweep_side_sign)
{
  int8_t s = signf_nonzero(LINE_CENTER_PIXEL - (float)CCD_Center);
  if (s == 0)
  {
    s = sweep_side_sign;
  }
  if (s == 0)
  {
    s = s_turn_sign;
  }
  if (s == 0)
  {
    s = signf_nonzero(s_last_error);
  }
  if (s == 0)
  {
    s = s_hist_sign;
  }
  if (s == 0)
  {
    s = 1;
  }
  remember_sign(s);
  return s;
}

/* 完成一侧扫后：进入对侧，或一轮结束决定再扫/停 */
static void on_sweep_side_done(uint8_t just_finished_left)
{
  if (just_finished_left != 0U)
  {
    if (s_pref_right == 0U)
    {
      /* L 先：下一侧 R */
      enter_state(LF_SWEEP_R);
    }
    else
    {
      /* R 先、L 为第二侧：本轮结束 */
      s_sweep_round++;
      if (s_sweep_round >= LINE_SWEEP_ROUNDS)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_R);
      }
    }
  }
  else
  {
    if (s_pref_right != 0U)
    {
      /* R 先：下一侧 L */
      enter_state(LF_SWEEP_L);
    }
    else
    {
      /* L 先、R 为第二侧：本轮结束 */
      s_sweep_round++;
      if (s_sweep_round >= LINE_SWEEP_ROUNDS)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_L);
      }
    }
  }
}

void LineFollow_Init(void)
{
  /* 转向环：Kp=0.9, Ki=0.02(消除稳态偏差), Kd=0.04, dt=0.025(实际帧周期~25ms) */
  PID_init(&line_steer_pid, 0.9f, 0.02f, 0.04f, 0.025f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  line_error = 0.0f;
  line_wz = 0.0f;
  line_vL = 0;
  line_vR = 0;
  line_vL_signed = 0;
  line_vR_signed = 0;
  line_state = LF_FOLLOW;
  s_last_error = 0.0f;
  s_turn_sign = 0;
  s_hist_sign = 0;
  s_predict_sign = 0;
  s_phase_frames = 0U;
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_pref_right = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL = 0.0f;
  float vR = 0.0f;

  if (line_enabled == 0U)
  {
    return;
  }

  /* ---------- LF_FOLLOW：有线 PID / 降速 / pivot ---------- */
  if (line_state == LF_FOLLOW)
  {
    if (CCD_LineValid != 0U)
    {
      s_recover_frames = 0U;
      follow_with_line(&vL, &vR);
      output_lr(vL, vR);
      return;
    }

    /* 丢线：弯道中（有方向）直接扫线，直道上先后退再扫 */
    enter_backup_from_lost();
  }

  /* 恢复段累计超时 */
  if ((line_state != LF_FOLLOW) && (line_state != LF_STOP))
  {
    if (s_recover_frames < 0xFFFFU)
    {
      s_recover_frames++;
    }
    if (s_recover_frames > LINE_RECOVER_MAX_FRAMES)
    {
      enter_state(LF_STOP);
    }
  }

  if (s_phase_frames < 0xFFFFU)
  {
    s_phase_frames++;
  }

  switch (line_state)
  {
    case LF_BACKUP:
      if (CCD_LineValid != 0U)
      {
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
        break;
      }

      /* TIM7 尊重 MOTOR_MODE_BACK，开环维持后退占空比 */
      Motor_backward(LINE_BACKUP_SPEED);
      line_error = s_last_error;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;

      if (s_phase_frames >= LINE_BACKUP_FRAMES)
      {
        plan_sweep_order();
      }
      break;

    case LF_SWEEP_L:
      /* 左扫：差速反转左转 */
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(-1);
        enter_state(LF_COMMIT);
        apply_pivot(s_predict_sign, &vL, &vR);
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
        output_lr(vL, vR);
        break;
      }

      apply_pivot(-1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(1U);
      }
      break;

    case LF_SWEEP_R:
      /* 右扫：差速反转右转 */
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(+1);
        enter_state(LF_COMMIT);
        apply_pivot(s_predict_sign, &vL, &vR);
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
        output_lr(vL, vR);
        break;
      }

      apply_pivot(+1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(0U);
      }
      break;

    case LF_COMMIT:
      apply_pivot(s_predict_sign, &vL, &vR);
      if (CCD_LineValid != 0U)
      {
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
      }
      else
      {
        line_error = s_last_error;
      }
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_COMMIT_FRAMES)
      {
        enter_state(LF_FOLLOW);
      }
      break;

    case LF_STOP:
      line_error = 0.0f;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;
      Motor_Coast();
      if (CCD_LineValid != 0U)
      {
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
      }
      break;

    default:
      enter_state(LF_FOLLOW);
      break;
  }
}

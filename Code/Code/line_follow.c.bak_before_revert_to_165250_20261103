#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* ======================== 巡线参数（稳妥默认，路测可改宏） ======================== */
#define LINE_CENTER_PIXEL        64.0f
#define LINE_BASE_SPEED          38.0f
#define LINE_WZ_LIMIT            50.0f

/* |error|>=此值：差速正反转 pivot（一轮正转一轮反转）；大误差立即锁方向 */
#define LINE_PIVOT_ERR           25.0f
#define LINE_PIVOT_SPEED         40.0f
/* |error|>=此值但未达 PIVOT：降速差速 */
#define LINE_SOFT_ERR            14.0f
#define LINE_SOFT_BASE_SCALE     0.6f

/* 有线预判：|e|>=阈值连续 N 帧才更新 turn_sign（更早更稳） */
#define LINE_PREDICT_ERR         6.0f
#define LINE_PREDICT_HOLD_FRAMES 2U

/* 贴边中心：立即锁几何方向（勿全局翻 STEER；小弯 PID 极性保持） */
#define LINE_EDGE_LEFT_MAX       28U
#define LINE_EDGE_RIGHT_MIN      100U

/* 中心趋势 Δcenter：同向连续 N 帧且 |Δ|>=min => 更新 turn_sign */
#define LINE_TREND_DELTA_MIN     3.0f
#define LINE_TREND_HOLD_FRAMES   2U

/* LineValid 去抖：连续无效帧数才判丢线 */
#define LINE_LOST_DEBOUNCE_FRAMES 2U

/* ---- 丢线恢复：有方向 -> SEARCH pivot；无方向才允许一次短 BACKUP ---- */
/* 主循环约 20ms/帧（CCD + HAL_Delay(20)） */
#define LINE_SEARCH_MAX_FRAMES   70U   /* ~1.4s 锁定方向搜线 */
#define LINE_BACKUP_SPEED        28U
#define LINE_BACKUP_FRAMES       12U   /* ~0.24s；仅完全无方向且本段未用过 */
#define LINE_SWEEP_FRAMES        25U   /* ~0.50s 单侧兜底 */
#define LINE_SWEEP_ROUNDS        1U
#define LINE_COMMIT_FRAMES       4U    /* 兼容保留；正常见线直接 FOLLOW */
#define LINE_RECOVER_MAX_FRAMES  150U  /* ~3.0s 总超时强制停 */
#define LINE_FOLLOW_STABLE_FRAMES 8U   /* 稳定跟线后允许下一段再用一次 BACKUP */

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile int16_t  line_vL_signed = 0;
volatile int16_t  line_vR_signed = 0;
volatile uint8_t line_enabled = 1;
volatile uint8_t line_state = LF_FOLLOW;
volatile int8_t  line_turn_sign = 0;

static float s_last_error = 0.0f;
static int8_t s_turn_sign = 0;       /* error>0 => +1：与现有 PID/pivot 同号约定 */
static int8_t s_hist_sign = 0;       /* 上次有效转弯方向 */
static int8_t s_search_sign = 0;     /* SEARCH/扫线锁定方向 */
static int8_t s_predict_sign = 0;    /* COMMIT 兼容 */
static uint16_t s_predict_hold = 0U;

static float s_prev_center = LINE_CENTER_PIXEL;
static int8_t s_trend_dir = 0;
static uint8_t s_trend_hold = 0U;
static uint8_t s_edge_latched = 0U;  /* 本段有线时曾贴边 */

static uint16_t s_phase_frames = 0U;
static uint16_t s_recover_frames = 0U;
static uint16_t s_follow_stable = 0U;
static uint8_t  s_lost_debounce = 0U;
static uint8_t  s_sweep_round = 0U;
static uint8_t  s_pref_right = 0U;
static uint8_t  s_backup_used = 0U;

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static float absf(float v)
{
  return (v < 0.0f) ? -v : v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

static void sync_turn_sign_vofa(void)
{
  line_turn_sign = s_turn_sign;
}

static void remember_sign(int8_t s)
{
  if (s != 0)
  {
    s_hist_sign = s;
  }
}

static void set_turn_sign(int8_t s)
{
  if (s == 0)
  {
    return;
  }
  s_turn_sign = s;
  remember_sign(s);
  sync_turn_sign_vofa();
}

/* 保留现有正反转 pivot 极性（小弯 PID 不动，不全局翻 STEER） */
static void apply_pivot(int8_t sign, float *vL, float *vR)
{
  if (sign > 0)
  {
    /* 与现网一致：sign>0 -> 左反右正 */
    *vL = -LINE_PIVOT_SPEED;
    *vR =  LINE_PIVOT_SPEED;
    line_wz = LINE_PIVOT_SPEED;
  }
  else if (sign < 0)
  {
    *vL =  LINE_PIVOT_SPEED;
    *vR = -LINE_PIVOT_SPEED;
    line_wz = -LINE_PIVOT_SPEED;
  }
  else
  {
    *vL = LINE_BASE_SPEED;
    *vR = LINE_BASE_SPEED;
    line_wz = 0.0f;
  }
}

static void enter_state(uint8_t st)
{
  line_state = st;
  s_phase_frames = 0U;
}

/*
 * 搜线方向：中心趋势优先于瞬时残段 error。
 * 大 |last_error| / 曾贴边时，不用残段单独定方向，避免直角反侧。
 * 不全局反转有线 PID / turn_sign。
 */
static int8_t resolve_search_sign(void)
{
  int8_t lock = 0;
  uint8_t remnant_risky;

  remnant_risky = 0U;
  if ((absf(s_last_error) >= LINE_PIVOT_ERR) || (s_edge_latched != 0U))
  {
    remnant_risky = 1U;
  }

  if ((s_trend_dir != 0) && (s_trend_hold >= LINE_TREND_HOLD_FRAMES))
  {
    lock = s_trend_dir;
  }
  else if (s_turn_sign != 0)
  {
    lock = s_turn_sign;
  }
  else if (s_hist_sign != 0)
  {
    lock = s_hist_sign;
  }
  else if (remnant_risky == 0U)
  {
    lock = signf_nonzero(s_last_error);
  }
  /* remnant_risky 且无趋势/hist：返回 0 -> 允许一次短 BACKUP */

  return lock;
}

static void clear_steer_integral(void)
{
  line_steer_pid.integral = 0.0f;
}

static void enter_search(int8_t sign)
{
  clear_steer_integral();
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  s_search_sign = sign;
  remember_sign(sign);
  enter_state(LF_SEARCH);
}

static void plan_sweep_order(void)
{
  int8_t lock;

  clear_steer_integral();
  lock = resolve_search_sign();
  if (lock == 0)
  {
    lock = s_search_sign;
  }

  if (lock > 0)
  {
    s_pref_right = 1U;
    s_search_sign = lock;
    enter_state(LF_SWEEP_R);
  }
  else
  {
    s_pref_right = 0U;
    if (lock < 0)
    {
      s_search_sign = lock;
    }
    enter_state(LF_SWEEP_L);
  }
}

static void enter_backup_once(void)
{
  clear_steer_integral();
  s_recover_frames = 0U;
  s_sweep_round = 0U;
  s_predict_sign = 0;
  s_pref_right = 0U;
  s_backup_used = 1U;
  enter_state(LF_BACKUP);
}

/* 丢线：有 turn_sign/hist/趋势 -> 不后退，直接锁定方向 SEARCH；否则一次短 BACKUP */
static void on_line_lost_from_follow(void)
{
  int8_t lock;

  lock = resolve_search_sign();
  if (lock != 0)
  {
    enter_search(lock);
    return;
  }

  if (s_backup_used == 0U)
  {
    enter_backup_once();
    return;
  }

  /* 本段已 BACKUP 过仍无方向：L/R 兜底扫 */
  plan_sweep_order();
}

static void output_lr(float vL, float vR)
{
  vL = clampf(vL, -(float)MAX_SPEED, (float)MAX_SPEED);
  vR = clampf(vR, -(float)MAX_SPEED, (float)MAX_SPEED);

  line_vL_signed = (int16_t)vL;
  line_vR_signed = (int16_t)vR;
  line_vL = (uint16_t)(vL < 0.0f ? -vL : vL);
  line_vR = (uint16_t)(vR < 0.0f ? -vR : vR);

  if ((vL < 0.0f) || (vR < 0.0f))
  {
    Motor_SetLR_signed((int16_t)vL, (int16_t)vR);
  }
  else
  {
    Motor_SetLR((uint16_t)vL, (uint16_t)vR);
  }
}

static void update_turn_sign_stable(float abs_err, int8_t err_sign)
{
  if ((abs_err >= LINE_PREDICT_ERR) && (err_sign != 0))
  {
    if (s_predict_hold < 0xFFFFU)
    {
      s_predict_hold++;
    }
    if (s_predict_hold >= LINE_PREDICT_HOLD_FRAMES)
    {
      set_turn_sign(err_sign);
    }
  }
  else
  {
    s_predict_hold = 0U;
  }
}

static void update_turn_sign_edge(void)
{
  if (CCD_Center <= LINE_EDGE_LEFT_MAX)
  {
    set_turn_sign(+1);
    s_edge_latched = 1U;
  }
  else if (CCD_Center >= LINE_EDGE_RIGHT_MIN)
  {
    set_turn_sign(-1);
    s_edge_latched = 1U;
  }
}

static void update_turn_sign_trend(void)
{
  float delta;
  int8_t move_sign;

  delta = (float)CCD_Center - s_prev_center;
  move_sign = 0;
  if (delta <= -LINE_TREND_DELTA_MIN)
  {
    /* center 变小 => 线偏左 => error 倾向 + */
    move_sign = +1;
  }
  else if (delta >= LINE_TREND_DELTA_MIN)
  {
    move_sign = -1;
  }

  if (move_sign != 0)
  {
    if (move_sign == s_trend_dir)
    {
      if (s_trend_hold < 0xFFU)
      {
        s_trend_hold++;
      }
      if (s_trend_hold >= LINE_TREND_HOLD_FRAMES)
      {
        set_turn_sign(move_sign);
      }
    }
    else
    {
      s_trend_dir = move_sign;
      s_trend_hold = 1U;
    }
  }
  else
  {
    s_trend_dir = 0;
    s_trend_hold = 0U;
  }

  s_prev_center = (float)CCD_Center;
}

static void follow_with_line(float *vL, float *vR)
{
  float wz;
  float abs_err;
  float base;
  int8_t err_sign;

  wz = PID_location(&line_steer_pid, (float)CCD_Center);
  wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
  line_error = line_steer_pid.error;
  abs_err = absf(line_error);
  err_sign = signf_nonzero(line_error);

  s_last_error = line_error;

  /* 更早更稳的预判：连续同向 Δcenter + 贴边 + |e| hold=2 */
  update_turn_sign_stable(abs_err, err_sign);
  update_turn_sign_edge();
  update_turn_sign_trend();

  if (abs_err >= LINE_PIVOT_ERR)
  {
    apply_pivot(err_sign, vL, vR);
    if (err_sign != 0)
    {
      /* 大误差 pivot：立即锁方向 */
      set_turn_sign(err_sign);
      s_predict_hold = LINE_PREDICT_HOLD_FRAMES;
    }
  }
  else
  {
    base = LINE_BASE_SPEED;
    if (abs_err >= LINE_SOFT_ERR)
    {
      base = LINE_BASE_SPEED * LINE_SOFT_BASE_SCALE;
    }
    line_wz = wz;
    *vL = base - wz;
    *vR = base + wz;
  }

  sync_turn_sign_vofa();
}

static int8_t make_predict_sign(int8_t sweep_side_sign)
{
  int8_t s = 0;

  if ((s_trend_dir != 0) && (s_trend_hold >= LINE_TREND_HOLD_FRAMES))
  {
    s = s_trend_dir;
  }
  if (s == 0)
  {
    s = signf_nonzero(LINE_CENTER_PIXEL - (float)CCD_Center);
  }
  if (s == 0)
  {
    s = sweep_side_sign;
  }
  if (s == 0)
  {
    s = s_search_sign;
  }
  if (s == 0)
  {
    s = s_turn_sign;
  }
  if (s == 0)
  {
    s = s_hist_sign;
  }
  if (s == 0)
  {
    s = 1;
  }
  remember_sign(s);
  return s;
}

static void on_sweep_side_done(uint8_t just_finished_left)
{
  if (just_finished_left != 0U)
  {
    if (s_pref_right == 0U)
    {
      enter_state(LF_SWEEP_R);
    }
    else
    {
      s_sweep_round++;
      if (s_sweep_round >= LINE_SWEEP_ROUNDS)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_R);
      }
    }
  }
  else
  {
    if (s_pref_right != 0U)
    {
      enter_state(LF_SWEEP_L);
    }
    else
    {
      s_sweep_round++;
      if (s_sweep_round >= LINE_SWEEP_ROUNDS)
      {
        enter_state(LF_STOP);
      }
      else
      {
        enter_state(LF_SWEEP_L);
      }
    }
  }
}

/* 见线：直接 FOLLOW，取消长 COMMIT */
static void resume_follow_from_search(float *vL, float *vR)
{
  s_recover_frames = 0U;
  s_lost_debounce = 0U;
  s_follow_stable = 0U;
  enter_state(LF_FOLLOW);
  follow_with_line(vL, vR);
  output_lr(*vL, *vR);
}

void LineFollow_Init(void)
{
  /* 转向环：Kp=0.9, Ki=0.02, Kd=0.04, dt=0.025（实际帧周期~25ms） */
  PID_init(&line_steer_pid, 0.9f, 0.02f, 0.04f, 0.025f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  line_error = 0.0f;
  line_wz = 0.0f;
  line_vL = 0;
  line_vR = 0;
  line_vL_signed = 0;
  line_vR_signed = 0;
  line_state = LF_FOLLOW;
  line_turn_sign = 0;
  s_last_error = 0.0f;
  s_turn_sign = 0;
  s_hist_sign = 0;
  s_search_sign = 0;
  s_predict_sign = 0;
  s_predict_hold = 0U;
  s_prev_center = LINE_CENTER_PIXEL;
  s_trend_dir = 0;
  s_trend_hold = 0U;
  s_edge_latched = 0U;
  s_phase_frames = 0U;
  s_recover_frames = 0U;
  s_follow_stable = 0U;
  s_lost_debounce = 0U;
  s_sweep_round = 0U;
  s_pref_right = 0U;
  s_backup_used = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL = 0.0f;
  float vR = 0.0f;

  if (line_enabled == 0U)
  {
    return;
  }

  /* ---------- LF_FOLLOW：有线 PID / 降速 / pivot ---------- */
  if (line_state == LF_FOLLOW)
  {
    if (CCD_LineValid != 0U)
    {
      s_lost_debounce = 0U;
      s_recover_frames = 0U;
      if (s_follow_stable < 0xFFFFU)
      {
        s_follow_stable++;
      }
      if (s_follow_stable >= LINE_FOLLOW_STABLE_FRAMES)
      {
        s_backup_used = 0U;
        s_edge_latched = 0U;
      }
      follow_with_line(&vL, &vR);
      output_lr(vL, vR);
      return;
    }

    /* 去抖：连续 2 帧无效才判丢线 */
    if (s_lost_debounce < 0xFFU)
    {
      s_lost_debounce++;
    }
    if (s_lost_debounce < LINE_LOST_DEBOUNCE_FRAMES)
    {
      /* 闪断保向：优先 turn/hist，短暂维持差速；不做丢线切换 */
      int8_t hold = s_turn_sign;
      if (hold == 0) { hold = s_hist_sign; }
      if (hold == 0) { hold = signf_nonzero(s_last_error); }
      if (hold != 0)
      {
        apply_pivot(hold, &vL, &vR);
      }
      else
      {
        vL = LINE_BASE_SPEED;
        vR = LINE_BASE_SPEED;
        line_wz = 0.0f;
      }
      line_error = s_last_error;
      output_lr(vL, vR);
      return;
    }

    s_follow_stable = 0U;
    on_line_lost_from_follow();
  }

  /* 恢复段累计超时 */
  if ((line_state != LF_FOLLOW) && (line_state != LF_STOP))
  {
    if (s_recover_frames < 0xFFFFU)
    {
      s_recover_frames++;
    }
    if (s_recover_frames > LINE_RECOVER_MAX_FRAMES)
    {
      enter_state(LF_STOP);
    }
  }

  if (s_phase_frames < 0xFFFFU)
  {
    s_phase_frames++;
  }

  switch (line_state)
  {
    case LF_BACKUP:
      /* 短后退期间忽略闪线，避免 BACKUP<->FOLLOW 抖；结束后再锁搜 */
      Motor_backward(LINE_BACKUP_SPEED);
      line_error = s_last_error;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;
      line_vL_signed = 0;
      line_vR_signed = 0;

      if (s_phase_frames >= LINE_BACKUP_FRAMES)
      {
        int8_t lock = resolve_search_sign();
        if (lock != 0)
        {
          enter_search(lock);
        }
        else
        {
          plan_sweep_order();
        }
      }
      break;

    case LF_SEARCH:
      /* 有方向：Motor_SetLR_signed pivot 搜线 ~1.4s；见线直接 FOLLOW */
      if (CCD_LineValid != 0U)
      {
        resume_follow_from_search(&vL, &vR);
        break;
      }

      apply_pivot(s_search_sign, &vL, &vR);
      line_error = s_last_error;
      sync_turn_sign_vofa();
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SEARCH_MAX_FRAMES)
      {
        enter_state(LF_STOP);
      }
      break;

    case LF_SWEEP_L:
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(-1);
        resume_follow_from_search(&vL, &vR);
        break;
      }

      clear_steer_integral();
      apply_pivot(-1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(1U);
      }
      break;

    case LF_SWEEP_R:
      if (CCD_LineValid != 0U)
      {
        s_predict_sign = make_predict_sign(+1);
        resume_follow_from_search(&vL, &vR);
        break;
      }

      clear_steer_integral();
      apply_pivot(+1, &vL, &vR);
      line_error = s_last_error;
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_SWEEP_FRAMES)
      {
        on_sweep_side_done(0U);
      }
      break;

    case LF_COMMIT:
      /* 兼容保留；正常路径已直接 FOLLOW */
      apply_pivot(s_predict_sign, &vL, &vR);
      if (CCD_LineValid != 0U)
      {
        line_error = LINE_CENTER_PIXEL - (float)CCD_Center;
      }
      else
      {
        line_error = s_last_error;
      }
      output_lr(vL, vR);

      if (s_phase_frames >= LINE_COMMIT_FRAMES)
      {
        enter_state(LF_FOLLOW);
      }
      break;

    case LF_STOP:
      line_error = 0.0f;
      line_wz = 0.0f;
      line_vL = 0;
      line_vR = 0;
      line_vL_signed = 0;
      line_vR_signed = 0;
      Motor_Coast();
      if (CCD_LineValid != 0U)
      {
        s_backup_used = 0U;
        s_follow_stable = 0U;
        s_lost_debounce = 0U;
        enter_state(LF_FOLLOW);
        follow_with_line(&vL, &vR);
        output_lr(vL, vR);
      }
      break;

    default:
      enter_state(LF_FOLLOW);
      break;
  }
}
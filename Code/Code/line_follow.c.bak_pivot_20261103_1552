#include "line_follow.h"
#include "ccd.h"
#include "motor.h"

/* 图像中线目标像素（128 点 CCD 中心） */
#define LINE_CENTER_PIXEL   64.0f
/* 巡线基础速度 0~100：保留用户当前调参 */
#define LINE_BASE_SPEED     40.0f
/* 丢线预判搜索时的前进速度（低于 BASE，避免冲出） */
#define LINE_SEARCH_SPEED   30.0f
/* 丢线搜索固定差速幅值（方向由 s_search_sign 锁定） */
#define LINE_SEARCH_WZ      50.0f
/* 左右差速限幅：保留用户当前调参 */
#define LINE_WZ_LIMIT       50.0f
/* |error| 达到该阈值且连续若干帧后，更新预判转弯符号 */
#define LINE_PREDICT_ERR         7.0f
#define LINE_PREDICT_HOLD_FRAMES 1U
/* 最近 N 帧 error 符号滑动投票，丢线时优先用投票结果 */
#define LINE_SIGN_HIST_N         5U
/* 连续丢线超过该帧数仍未找回则停车（主循环约 20ms/帧，约 1.8s） */
#define LINE_SEARCH_MAX_FRAMES   90U

PID line_steer_pid;

volatile float line_error = 0.0f;
volatile float line_wz = 0.0f;
volatile uint16_t line_vL = 0;
volatile uint16_t line_vR = 0;
volatile uint8_t line_enabled = 1;

/* 有线时维护的最后有效纠偏；丢线瞬间锁定搜索方向 */
static float s_last_wz = 0.0f;
static float s_last_error = 0.0f;
static float s_last_center = LINE_CENTER_PIXEL;
static uint16_t s_lost_frames = 0U;
static int8_t s_turn_sign = 0;       /* 有线预判：error>0 → +1 */
static int8_t s_search_sign = 0;     /* 丢线首帧锁定，搜索全程固定；有线时不清零 */
static int8_t s_recent_sign = 0;     /* 最近一次 |error|>=PREDICT_ERR 的 sign(error) */
static uint16_t s_predict_hold = 0U; /* |error|>=阈值的连续帧数 */
static int8_t s_sign_hist[LINE_SIGN_HIST_N];
static uint8_t s_sign_hist_idx = 0U;
static uint8_t s_sign_hist_count = 0U;

static float clampf(float v, float lo, float hi)
{
  if (v < lo) return lo;
  if (v > hi) return hi;
  return v;
}

static int8_t signf_nonzero(float v)
{
  if (v > 0.0f) return 1;
  if (v < 0.0f) return -1;
  return 0;
}

/* 最近 N 帧 error 符号累加投票；和为 0 则无共识 */
static int8_t sign_hist_vote(void)
{
  int16_t sum = 0;
  uint8_t i;

  if (s_sign_hist_count == 0U)
  {
    return 0;
  }

  for (i = 0U; i < s_sign_hist_count; i++)
  {
    sum = (int16_t)(sum + (int16_t)s_sign_hist[i]);
  }

  return signf_nonzero((float)sum);
}

static void sign_hist_push(int8_t s)
{
  s_sign_hist[s_sign_hist_idx] = s;
  s_sign_hist_idx++;
  if (s_sign_hist_idx >= (uint8_t)LINE_SIGN_HIST_N)
  {
    s_sign_hist_idx = 0U;
  }
  if (s_sign_hist_count < (uint8_t)LINE_SIGN_HIST_N)
  {
    s_sign_hist_count++;
  }
}

void LineFollow_Init(void)
{
  /* 转向环：target=中线像素，反馈 CCD_Center，输出作左右差速 */
  /* 保留用户当前调参：kp=0.9, ki=0, kd=0.04（勿改回 0.45/0.02） */
  PID_init(&line_steer_pid, 0.9f, 0.0f, 0.04f, 0.05f, 200.0f);
  line_steer_pid.target = LINE_CENTER_PIXEL;
  line_enabled = 1;
  s_last_wz = 0.0f;
  s_last_error = 0.0f;
  s_last_center = LINE_CENTER_PIXEL;
  s_lost_frames = 0U;
  s_turn_sign = 0;
  s_search_sign = 0;
  s_recent_sign = 0;
  s_predict_hold = 0U;
  s_sign_hist_idx = 0U;
  s_sign_hist_count = 0U;
  Motor_SetLR(0, 0);
}

void LineFollow_Update(void)
{
  float vL;
  float vR;
  float wz;
  float abs_err;
  int8_t err_sign;
  int8_t vote_sign;
  int8_t center_sign;

  if (line_enabled == 0U)
  {
    return;
  }

  if (CCD_LineValid != 0U)
  {
    wz = PID_location(&line_steer_pid, (float)CCD_Center);
    wz = clampf(wz, -LINE_WZ_LIMIT, LINE_WZ_LIMIT);
    line_error = line_steer_pid.error;
    line_wz = wz;

    /* 记住有效纠偏与中心，供丢线方向兜底；有线时不清 s_search_sign */
    s_last_wz = wz;
    s_last_error = line_error;
    s_last_center = (float)CCD_Center;
    s_lost_frames = 0U;

    abs_err = line_error;
    if (abs_err < 0.0f)
    {
      abs_err = -abs_err;
    }

    err_sign = signf_nonzero(line_error);
    /* 每帧推入滑动窗口（含近零记 0），丢线时投票 */
    sign_hist_push(err_sign);

    /* |error| 足够大：更新最近有效符号；连续 HOLD 帧后更新稳定预判 */
    if (abs_err >= LINE_PREDICT_ERR)
    {
      s_recent_sign = err_sign;
      if (s_predict_hold < 0xFFFFU)
      {
        s_predict_hold++;
      }
      if (s_predict_hold >= LINE_PREDICT_HOLD_FRAMES)
      {
        s_turn_sign = err_sign;
      }
    }
    else
    {
      s_predict_hold = 0U;
    }

    /* error=64-center>0 → 线偏左 → 左慢右快（wz>0 → vL小 vR大）视安装方向；
       若实车拐反，把下面 vL/vR 对调即可 */
    vL = LINE_BASE_SPEED - wz;
    vR = LINE_BASE_SPEED + wz;
  }
  else
  {
    /* 丢线：首帧按优先级锁定搜索符号，全程固定幅值转弯，超时停车 */
    line_steer_pid.integral = 0.0f;

    if (s_lost_frames == 0U)
    {
      /* 优先级：稳定预判 → 滑动投票 → 最近有效 sign(error)
         → sign(last_error) → sign(last_wz) → center vs 64 → 保持上次 s_search_sign */
      if (s_turn_sign != 0)
      {
        s_search_sign = s_turn_sign;
      }
      else
      {
        vote_sign = sign_hist_vote();
        if (vote_sign != 0)
        {
          s_search_sign = vote_sign;
        }
        else if (s_recent_sign != 0)
        {
          s_search_sign = s_recent_sign;
        }
        else
        {
          s_search_sign = signf_nonzero(s_last_error);
          if (s_search_sign == 0)
          {
            s_search_sign = signf_nonzero(s_last_wz);
          }
          if (s_search_sign == 0)
          {
            /* 丢线前最后一帧有效中心相对 64：center<64 → error>0 → +1 */
            center_sign = signf_nonzero(LINE_CENTER_PIXEL - s_last_center);
            if (center_sign != 0)
            {
              s_search_sign = center_sign;
            }
            /* 仍无则保持上一次成功的 s_search_sign，不清成 0 */
          }
        }
      }
    }

    if (s_lost_frames < 0xFFFFU)
    {
      s_lost_frames++;
    }

    if ((s_search_sign == 0) || (s_lost_frames > LINE_SEARCH_MAX_FRAMES))
    {
      /* 启动后从未有过方向，或搜索超时：停车，避免盲转越偏越远 */
      line_error = 0.0f;
      line_wz = 0.0f;
      vL = 0.0f;
      vR = 0.0f;
    }
    else
    {
      wz = (float)s_search_sign * LINE_SEARCH_WZ;
      line_error = s_last_error;
      line_wz = wz;
      vL = LINE_SEARCH_SPEED - wz;
      vR = LINE_SEARCH_SPEED + wz;
    }
  }

  vL = clampf(vL, 0.0f, (float)MAX_SPEED);
  vR = clampf(vR, 0.0f, (float)MAX_SPEED);
  line_vL = (uint16_t)vL;
  line_vR = (uint16_t)vR;
  Motor_SetLR(line_vL, line_vR);
}